summary: test if fapolicyd stays running when config file is broken
contact: Milos Malik <mmalik@redhat.com>
test: ./runtest.sh
duration: 5m
enabled: true
require:
  - fapolicyd
  - fapolicyd-selinux
tag:
  - NoRHEL4
  - NoRHEL5
  - NoRHEL6
  - NoRHEL7
  - NoRHEL8
  - Tier1
  - CI-Tier-1
adjust+:
  - enabled: false
    when: distro < rhel-9
    continue: false
link:
  - verifies: https://issues.redhat.com/browse/RHEL-189484
  - verifies: https://issues.redhat.com/browse/RHEL-216973
id: 6d8e2fa3-f732-4e72-ac55-9188f597daf0
