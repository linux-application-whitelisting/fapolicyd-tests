summary: test if trust DB has correct user/group/mode etc.
contact: Milos Malik <mmalik@redhat.com>
test: ./runtest.sh
duration: 5m
enabled: true
require:
  - fapolicyd
  - fapolicyd-selinux
tag:
  - NoRHEL4
  - NoRHEL5
  - NoRHEL6
  - NoRHEL7
  - NoRHEL8
adjust+:
  - enabled: false
    when: distro == rhel-4, rhel-5, rhel-6, rhel-7, rhel-8
    continue: false
link:
  - verifies: https://issues.redhat.com/browse/RHEL-186511
  - verifies: https://issues.redhat.com/browse/RHEL-186512

