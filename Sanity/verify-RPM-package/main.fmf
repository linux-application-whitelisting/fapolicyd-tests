summary: test if anything is missing from the package
contact: Milos Malik <mmalik@redhat.com>
test: ./runtest.sh
duration: 5m
enabled: true
require:
  - fapolicyd
  - fapolicyd-selinux
tag:
  - NoRHEL4
  - NoRHEL5
  - NoRHEL6
  - NoRHEL7
  - NoRHEL8
  - Tier1
tier: 1
adjust+:
  - enabled: false
    when: distro == rhel-4, rhel-5, rhel-6, rhel-7, rhel-8
    continue: false
link:
  - verifies: https://issues.redhat.com/browse/RHEL-186528
  - verifies: https://issues.redhat.com/browse/RHEL-186534

